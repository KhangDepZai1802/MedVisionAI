<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MedVisionAI</AssemblyName>
    <RootNamespace>MedVisionAI</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\Brand\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.17.3" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.9.0.20240103" />
  </ItemGroup>

  <!-- Thêm đoạn này -->
  <ItemGroup>
    <Resource Include="Assets\Brand\AppIcon.ico"/>
    <Resource Include="Assets\Brand\logoNST.png"/>
    <Resource Include="Assets\Brand\HeroLogo.png"/>
    <Resource Include="Assets\Brand\BloodDetection.png"/>
    <Resource Include="Assets\Brand\Parasite.png"/>
    <Resource Include="Assets\Brand\NST.png"/>
    <Resource Include="Themes\KrakenTheme.xaml"/>
    <Resource Include="Themes\Animations.xaml"/>
  </ItemGroup>

</Project>
