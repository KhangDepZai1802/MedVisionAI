<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════
         KRAKEN COLOR PALETTE
    ═══════════════════════════════════════════════════════════ -->
    <Color x:Key="PrimaryColor">#7132F5</Color>
    <Color x:Key="PrimaryDarkColor">#5E22D4</Color>
    <Color x:Key="PrimaryLightColor">#A855F7</Color>
    <Color x:Key="PrimaryGhostColor">#F3EEFF</Color>
    <Color x:Key="PrimaryBorderColor">#D4BBFF</Color>

    <Color x:Key="BackgroundColor">#F7F7FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#101114</Color>
    <Color x:Key="TextSecondaryColor">#9090A8</Color>
    <Color x:Key="TextMutedColor">#B0B0C0</Color>
    <Color x:Key="BorderColor">#EBEBF0</Color>
    <Color x:Key="BorderLightColor">#F0F0F8</Color>

    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="SuccessLightColor">#DCFCE7</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerLightColor">#FFF0F0</Color>
    <Color x:Key="WarningColor">#D97706</Color>

    <!-- Module accent colors -->
    <Color x:Key="NSTColor">#7132F5</Color>
    <Color x:Key="NSTLightColor">#F3EEFF</Color>
    <Color x:Key="BloodColor">#DC2626</Color>
    <Color x:Key="BloodLightColor">#FFF0F0</Color>
    <Color x:Key="MalariaColor">#16A34A</Color>
    <Color x:Key="MalariaLightColor">#F0FDF4</Color>
    <Color x:Key="LungColor">#2563EB</Color>
    <Color x:Key="LungLightColor">#EFF6FF</Color>

    <!-- ═══════════════════════════════════════════════════════════
         SOLID COLOR BRUSHES
    ═══════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryGhostBrush" Color="{StaticResource PrimaryGhostColor}"/>
    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="{StaticResource PrimaryBorderColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLightColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLightColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>

    <!-- ═══════════════════════════════════════════════════════════
         GRADIENT BRUSHES
    ═══════════════════════════════════════════════════════════ -->
    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7132F5" Offset="0"/>
        <GradientStop Color="#A855F7" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TopBarGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#FDFCFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══════════════════════════════════════════════════════════
         DROP SHADOW EFFECTS
    ═══════════════════════════════════════════════════════════ -->
    <DropShadowEffect x:Key="CardShadow"
                      Color="#7132F5" BlurRadius="18"
                      ShadowDepth="3" Opacity="0.08" Direction="270"/>

    <DropShadowEffect x:Key="WindowShadow"
                      Color="#000000" BlurRadius="32"
                      ShadowDepth="6" Opacity="0.18" Direction="270"/>

    <DropShadowEffect x:Key="HeroShadow"
                      Color="#7132F5" BlurRadius="28"
                      ShadowDepth="8" Opacity="0.22" Direction="270"/>

    <DropShadowEffect x:Key="ButtonShadow"
                      Color="#7132F5" BlurRadius="12"
                      ShadowDepth="2" Opacity="0.15" Direction="270"/>

    <!-- ═══════════════════════════════════════════════════════════
         TYPOGRAPHY
    ═══════════════════════════════════════════════════════════ -->
    <FontFamily x:Key="PrimaryFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>
    <system:Double x:Key="FontSizeXS">10</system:Double>
    <system:Double x:Key="FontSizeSM">11</system:Double>
    <system:Double x:Key="FontSizeMD">13</system:Double>
    <system:Double x:Key="FontSizeLG">15</system:Double>
    <system:Double x:Key="FontSizeXL">18</system:Double>
    <system:Double x:Key="FontSizeXXL">22</system:Double>
    <system:Double x:Key="FontSizeHero">32</system:Double>

    <!-- ═══════════════════════════════════════════════════════════
         SCROLLBAR STYLE — minimal purple
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="MinimalScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="5"/>
        <Setter Property="Background" Value="#F0F0F8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Rectangle Fill="{TemplateBinding Background}" RadiusX="3" RadiusY="3"/>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Style>
                                        <Style TargetType="Thumb">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Rectangle Fill="#D0D0E8" RadiusX="3" RadiusY="3"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Thumb.Style>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KrakenScrollViewer" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0"/>
                        <ScrollBar Grid.Column="1"
                                   Style="{StaticResource MinimalScrollBar}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         BUTTON STYLES
    ═══════════════════════════════════════════════════════════ -->

    <!-- Primary Button -->
    <Style x:Key="BtnPrimary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ScaleT" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                        <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.15"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="{StaticResource PrimaryColor}" Duration="0:0:0.15"/>
                                        <ColorAnimation Storyboard.TargetName="ContentText"
                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                            To="White" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleT"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1.02" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleT"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1.02" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="{StaticResource PrimaryDarkColor}" Duration="0:0:0.05"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleT"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.97" Duration="0:0:0.05"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleT"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.97" Duration="0:0:0.05"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#F3F0FB" Duration="0:0:0"/>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                            To="#D4BBFF" Duration="0:0:0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <TextBlock x:Name="ContentText" Visibility="Collapsed"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger Button (Close) -->
    <Style x:Key="BtnDanger" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#9090A8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.12"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="{StaticResource DangerColor}" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#B91C1C" Duration="0:0:0.05"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Window Control Button (Min/Max) -->
    <Style x:Key="BtnWinCtrl" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#9090A8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.12"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#F0F0F8" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#E0E0F0" Duration="0:0:0.05"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#101114"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Icon Bubble Container -->
    <Style x:Key="IconBubble" TargetType="Border">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Card Style -->
    <Style x:Key="KrakenCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>

    <!-- Stat Card -->
    <Style x:Key="StatCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="18,16"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>

    <!-- Badge Active -->
    <Style x:Key="BadgeActive" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="12,3"/>
    </Style>

    <!-- Badge Soon -->
    <Style x:Key="BadgeSoon" TargetType="Border">
        <Setter Property="Background" Value="#F0F0F8"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="12,3"/>
    </Style>

    <!-- Section Label -->
    <Style x:Key="LabelSection" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
    </Style>

    <!-- Clock Label -->
    <Style x:Key="LabelClock" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="MinWidth" Value="190"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <!-- Separator line -->
    <Style x:Key="HRule" TargetType="Rectangle">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Fill" Value="{StaticResource BorderBrush}"/>
    </Style>

</ResourceDictionary>
