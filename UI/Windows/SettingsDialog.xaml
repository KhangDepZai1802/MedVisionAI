<Window x:Class="MedVisionAI.UI.Windows.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt hệ thống — MedVision AI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/Assets/Brand/AppIcon.ico"
        ResizeMode="NoResize"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border Margin="12" CornerRadius="16"
            Effect="{StaticResource WindowShadow}"
            Background="White">
        <StackPanel Margin="36,32,36,32">

            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Cấu hình hệ thống"
                               FontSize="20" FontWeight="Black" Foreground="#101114"/>
                    <TextBlock Text="Thay đổi model AI và các thông số phân tích"
                               FontSize="12" Foreground="#9090A8" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource BtnDanger}"
                        Content="✕" Click="BtnCancel_Click" VerticalAlignment="Top"/>
            </Grid>

            <Rectangle Style="{StaticResource HRule}" Margin="0,0,0,24"/>

            <!-- ── Section: Model AI ── -->
            <TextBlock Text="MODEL AI"
                       FontSize="10" FontWeight="Bold" Foreground="#7132F5"
                       Margin="0,0,0,14"/>

            <!-- Model 1 -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Model Phân đoạn NST (bắt buộc)"
                           FontSize="13" FontWeight="Bold" Foreground="#101114"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Tách từng NST ra khỏi ảnh · Đếm tổng số"
                           FontSize="11" Foreground="#9090A8" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FAFAFA"
                            BorderBrush="#D4BBFF" BorderThickness="1"
                            CornerRadius="8" Padding="12,10">
                        <TextBlock x:Name="PathSeg"
                                   FontSize="12" Foreground="#9090A8"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="2" Content="📂  Browse"
                            Click="BrowseSeg_Click"
                            Height="40" Padding="16,0"
                            FontSize="12" FontWeight="Bold"
                            Background="#7132F5" Foreground="White"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                                <VisualTransition GeneratedDuration="0:0:0.12"/>
                                            </VisualStateGroup.Transitions>
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="MouseOver">
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="Bd"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#5E22D4" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Model 2 -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Model Phân tách NST chồng lấn (tuỳ chọn)"
                           FontSize="13" FontWeight="Bold" Foreground="#101114"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Xử lý các NST bị đè lên nhau"
                           FontSize="11" Foreground="#9090A8" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FAFAFA"
                            BorderBrush="#EBEBF0" BorderThickness="1"
                            CornerRadius="8" Padding="12,10">
                        <TextBlock x:Name="PathOverlap"
                                   FontSize="12" Foreground="#9090A8"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Grid.Column="2" Content="📂  Browse"
                            Click="BrowseOverlap_Click"
                            Height="40" Padding="16,0"
                            FontSize="12" FontWeight="Bold"
                            Background="#9090A8" Foreground="White"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                                <VisualTransition GeneratedDuration="0:0:0.12"/>
                                            </VisualStateGroup.Transitions>
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="MouseOver">
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="Bd"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#7A7A90" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Model 3 -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Model Xác định bất thường NST (tuỳ chọn)"
                           FontSize="13" FontWeight="Bold" Foreground="#101114"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Phát hiện lệch bội, hội chứng di truyền"
                           FontSize="11" Foreground="#9090A8" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FAFAFA"
                            BorderBrush="#EBEBF0" BorderThickness="1"
                            CornerRadius="8" Padding="12,10">
                        <TextBlock x:Name="PathAnomaly"
                                   FontSize="12" Foreground="#9090A8"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Grid.Column="2" Content="📂  Browse"
                            Click="BrowseAnomaly_Click"
                            Height="40" Padding="16,0"
                            FontSize="12" FontWeight="Bold"
                            Background="#9090A8" Foreground="White"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                                <VisualTransition GeneratedDuration="0:0:0.12"/>
                                            </VisualStateGroup.Transitions>
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="MouseOver">
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="Bd"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#7A7A90" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>

            <Rectangle Style="{StaticResource HRule}" Margin="0,0,0,24"/>

            <!-- ── Section: Analysis parameters ── -->
            <TextBlock Text="THÔNG SỐ PHÂN TÍCH"
                       FontSize="10" FontWeight="Bold" Foreground="#7132F5"
                       Margin="0,0,0,14"/>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Normal count -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Số NST chuẩn (2n)"
                               FontSize="13" FontWeight="Bold" Foreground="#101114"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Người bình thường: 46"
                               FontSize="11" Foreground="#9090A8" Margin="0,0,0,8"/>
                    <Border Background="#FAFAFA" BorderBrush="#D4BBFF"
                            BorderThickness="1" CornerRadius="8">
                        <TextBox x:Name="NormalCount"
                                 Text="46" FontSize="14" FontWeight="Bold"
                                 Foreground="#101114" Background="Transparent"
                                 BorderThickness="0" Padding="12,10"
                                 HorizontalAlignment="Stretch"/>
                    </Border>
                </StackPanel>

                <!-- Tolerance -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Sai số cho phép (±)"
                               FontSize="13" FontWeight="Bold" Foreground="#101114"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Khoảng chấp nhận được"
                               FontSize="11" Foreground="#9090A8" Margin="0,0,0,8"/>
                    <Border Background="#FAFAFA" BorderBrush="#D4BBFF"
                            BorderThickness="1" CornerRadius="8">
                        <TextBox x:Name="Tolerance"
                                 Text="1" FontSize="14" FontWeight="Bold"
                                 Foreground="#101114" Background="Transparent"
                                 BorderThickness="0" Padding="12,10"
                                 HorizontalAlignment="Stretch"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Info note -->
            <Border Background="#FFF8EB" BorderBrush="#FDE68A"
                    BorderThickness="1" CornerRadius="10"
                    Padding="14,10" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💡" FontSize="14" Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#B45309">
                        <Run FontWeight="Bold">Lưu ý:</Run>
                        <Run>App hỗ trợ mọi model ONNX từ bất kỳ framework nào (PyTorch, TensorFlow, Keras...). Model cần được xuất sang định dạng .onnx để đạt hiệu suất tốt nhất.</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Hủy bỏ"
                        Height="44" FontSize="13" FontWeight="Bold"
                        Background="#F0F0F8" Foreground="#5A5A72"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="10" Padding="20,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.12"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#E8E8F0" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="2" Content="💾  Lưu cấu hình"
                        Height="44" Padding="28,0"
                        FontSize="14" FontWeight="Bold"
                        Background="#7132F5" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnSave_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.12"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#5E22D4" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

        </StackPanel>
    </Border>
</Window>
