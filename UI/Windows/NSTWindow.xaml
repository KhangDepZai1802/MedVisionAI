<Window x:Class="MedVisionAI.UI.Windows.NSTWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MedVision AI — Phân tích Nhiễm sắc thể"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/Assets/Brand/AppIcon.ico"
        ResizeMode="CanResize"
        MinWidth="1200" MinHeight="750"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <!-- ═══════════════════════════════════════════════════════
         REUSABLE BUTTON STYLES
         Quy tắc chung cho mọi action button trong NSTWindow:
           Normal  : viền màu, chữ màu, nền trắng
           Hover   : nền màu đặc, chữ trắng
           Disabled: nền xám nhạt, viền xám nhạt, chữ xám nhạt, Opacity 0.5
    ══════════════════════════════════════════════════════════= -->
    <Window.Resources>

        <!-- ── Template dùng chung: nhận màu qua TemplateBinding ── -->
        <!-- Purple action button (Tab0) -->
        <ControlTemplate x:Key="TplBtnPurple" TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}"
                    Opacity="{TemplateBinding Opacity}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualStateGroup.Transitions>
                            <VisualTransition GeneratedDuration="0:0:0.15"/>
                        </VisualStateGroup.Transitions>
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="MouseOver">
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="Bd"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#7132F5" Duration="0:0:0.15"/>
                                <ColorAnimation Storyboard.TargetName="Bd"
                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                    To="#7132F5" Duration="0:0:0.15"/>
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="Bd"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#F0F0F0" Duration="0"/>
                                <ColorAnimation Storyboard.TargetName="Bd"
                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                    To="#D0D0D0" Duration="0"/>
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Border>
        </ControlTemplate>

        <Style x:Key="BtnPurpleAction" TargetType="Button">
            <Setter Property="Background"       Value="White"/>
            <Setter Property="Foreground"       Value="#7132F5"/>
            <Setter Property="BorderBrush"      Value="#7132F5"/>
            <Setter Property="BorderThickness"  Value="1.5"/>
            <Setter Property="Template"         Value="{StaticResource TplBtnPurple}"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground"  Value="#B0B0B0"/>
                    <Setter Property="Opacity"     Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Red action button (Tab1) -->
        <ControlTemplate x:Key="TplBtnRed" TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}"
                    Opacity="{TemplateBinding Opacity}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualStateGroup.Transitions>
                            <VisualTransition GeneratedDuration="0:0:0.15"/>
                        </VisualStateGroup.Transitions>
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="MouseOver">
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="Bd"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#DC2626" Duration="0:0:0.15"/>
                                <ColorAnimation Storyboard.TargetName="Bd"
                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                    To="#DC2626" Duration="0:0:0.15"/>
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="Bd"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#F0F0F0" Duration="0"/>
                                <ColorAnimation Storyboard.TargetName="Bd"
                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                    To="#D0D0D0" Duration="0"/>
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Border>
        </ControlTemplate>

        <Style x:Key="BtnRedAction" TargetType="Button">
            <Setter Property="Background"       Value="White"/>
            <Setter Property="Foreground"       Value="#DC2626"/>
            <Setter Property="BorderBrush"      Value="#DC2626"/>
            <Setter Property="BorderThickness"  Value="1.5"/>
            <Setter Property="Template"         Value="{StaticResource TplBtnRed}"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground"  Value="#B0B0B0"/>
                    <Setter Property="Opacity"     Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Green action button (Tab2) -->
        <ControlTemplate x:Key="TplBtnGreen" TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}"
                    Opacity="{TemplateBinding Opacity}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualStateGroup.Transitions>
                            <VisualTransition GeneratedDuration="0:0:0.15"/>
                        </VisualStateGroup.Transitions>
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="MouseOver">
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="Bd"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#16A34A" Duration="0:0:0.15"/>
                                <ColorAnimation Storyboard.TargetName="Bd"
                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                    To="#16A34A" Duration="0:0:0.15"/>
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="Bd"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#F0F0F0" Duration="0"/>
                                <ColorAnimation Storyboard.TargetName="Bd"
                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                    To="#D0D0D0" Duration="0"/>
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Border>
        </ControlTemplate>

        <Style x:Key="BtnGreenAction" TargetType="Button">
            <Setter Property="Background"       Value="White"/>
            <Setter Property="Foreground"       Value="#16A34A"/>
            <Setter Property="BorderBrush"      Value="#16A34A"/>
            <Setter Property="BorderThickness"  Value="1.5"/>
            <Setter Property="Template"         Value="{StaticResource TplBtnGreen}"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground"  Value="#B0B0B0"/>
                    <Setter Property="Opacity"     Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border Margin="12" CornerRadius="10"
            Effect="{StaticResource WindowShadow}">
        <Border Background="#F7F7FB" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="62"/>   <!-- TopBar -->
                    <RowDefinition Height="Auto"/> <!-- Tab bar -->
                    <RowDefinition Height="*"/>    <!-- Content -->
                    <RowDefinition Height="30"/>   <!-- BottomBar -->
                </Grid.RowDefinitions>

                <!-- ═══════════════════════════════════
                     TOP BAR
                ═══════════════════════════════════ -->
                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#EBEBF0"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TopBar_MouseDown">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="Transparent" CornerRadius="12"
                                Width="46" Height="46" Margin="0,0,14,0">
                            <Image Source="/Assets/Brand/logoNST.png"
                                   Width="34" Height="34"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="MedVision AI"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#101114"/>
                            <TextBlock Text="Phân tích Nhiễm sắc thể"
                                       FontSize="11" Foreground="#9090A8"/>
                        </StackPanel>

                        <Button Grid.Column="3"
                                Content="← Trang chủ"
                                Height="34" Padding="16,0"
                                FontSize="12" FontWeight="Bold"
                                Background="White" Foreground="#7132F5"
                                BorderBrush="#7132F5" BorderThickness="1.5"
                                Cursor="Hand"
                                Click="BtnHome_Click"
                                Margin="0,0,16,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualStateGroup.Transitions>
                                                    <VisualTransition GeneratedDuration="0:0:0.15"/>
                                                </VisualStateGroup.Transitions>
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="MouseOver">
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#7132F5" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock x:Name="ClockLabel"
                                   Grid.Column="4"
                                   Style="{StaticResource LabelClock}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>

                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource BtnWinCtrl}" Content="─"
                                    Margin="0,0,2,0" Click="BtnMinimize_Click"/>
                            <Button x:Name="BtnMaxRestore"
                                    Style="{StaticResource BtnWinCtrl}" Content="□"
                                    Margin="0,0,2,0" Click="BtnMaxRestore_Click"/>
                            <Button Style="{StaticResource BtnDanger}" Content="✕"
                                    Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════
                     TAB BAR — 3 chức năng nhỏ
                ═══════════════════════════════════ -->
                <Border Grid.Row="1"
                        Background="White"
                        BorderBrush="#EBEBF0"
                        BorderThickness="0,0,0,1"
                        Padding="24,0">
                    <StackPanel Orientation="Horizontal">

                        <!-- Tab 0: Phân đoạn NST -->
                        <Button x:Name="Tab0Btn"
                                Click="Tab0_Click"
                                Height="46" Padding="20,0"
                                BorderThickness="0"
                                Background="Transparent"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TabBd" Background="Transparent"
                                            BorderThickness="0,0,0,3"
                                            BorderBrush="Transparent">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="TabIconBd"
                                                    Background="#F3EEFF" CornerRadius="8"
                                                    Width="28" Height="28" Margin="0,0,8,0">
                                                <TextBlock Text="🧬" FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="TabTitle0"
                                                           Text="Phân đoạn NST"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="#7132F5"/>
                                                <TextBlock Text="Tách &amp; đếm NST"
                                                           FontSize="10" Foreground="#9090A8"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Rectangle Width="1" Height="28" Fill="#EBEBF0"
                                   VerticalAlignment="Center" Margin="4,0"
                                   Visibility="Visible"/>

                        <!-- Tab 1: NST chồng chất -->
                        <Button x:Name="Tab1Btn"
                                Click="Tab1_Click"
                                Height="46" Padding="20,0"
                                BorderThickness="0"
                                Background="Transparent"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TabBd" Background="Transparent"
                                            BorderThickness="0,0,0,3"
                                            BorderBrush="Transparent">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#FFF0F0" CornerRadius="8"
                                                    Width="28" Height="28" Margin="0,0,8,0">
                                                <TextBlock Text="🔬" FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="TabTitle1"
                                                           Text="NST chồng chất"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="#9090A8"/>
                                                <TextBlock Text="Phân tách overlap"
                                                           FontSize="10" Foreground="#9090A8"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Rectangle Width="1" Height="28" Fill="#EBEBF0"
                                   VerticalAlignment="Center" Margin="4,0"
                                   Visibility="Collapsed"/>

                        <!-- Tab 2: Xác định bất thường -->
                        <Button x:Name="Tab2Btn"
                                Click="Tab2_Click"
                                Height="46" Padding="20,0"
                                BorderThickness="0"
                                Background="Transparent"
                                Cursor="Hand"
                                Visibility="Collapsed">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TabBd" Background="Transparent"
                                            BorderThickness="0,0,0,3"
                                            BorderBrush="Transparent">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#F0FDF4" CornerRadius="8"
                                                    Width="28" Height="28" Margin="0,0,8,0">
                                                <TextBlock Text="⚠️" FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="TabTitle2"
                                                           Text="Xác định bất thường"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="#9090A8"/>
                                                <TextBlock Text="Lệch bội &amp; hội chứng"
                                                           FontSize="10" Foreground="#9090A8"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Model badge (hiển thị model đang dùng của tab active) -->
                        <Border x:Name="ModelBadge"
                                Background="#F3EEFF" CornerRadius="8"
                                BorderBrush="#D4BBFF" BorderThickness="1"
                                Padding="12,4" Margin="20,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Model: " FontSize="11"
                                           Foreground="#9090A8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ModelBadgeText"
                                           Text="Chưa chọn"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#7132F5" VerticalAlignment="Center"
                                           MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="BtnChangeModel"
                                        Content="📂 Đổi"
                                        Height="22" Padding="8,0" Margin="8,0,0,0"
                                        FontSize="10" FontWeight="Bold"
                                        Background="#7132F5" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="BtnChangeModel_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════
                     MAIN CONTENT — Tab panels
                ═══════════════════════════════════ -->
                <Grid Grid.Row="2">

                    <!-- ── TAB 0: Phân đoạn NST ── -->
                    <Grid x:Name="PanelTab0" Margin="20" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="216"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <!-- Control panel -->
                        <Border Grid.Column="0"
                                Background="White"
                                BorderBrush="{StaticResource PrimaryBorderBrush}"
                                BorderThickness="1" CornerRadius="16"
                                Effect="{StaticResource CardShadow}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="ĐIỀU KHIỂN" FontSize="10" FontWeight="Bold"
                                           Foreground="#9090A8" Margin="0,0,0,14"/>
                                <Rectangle Style="{StaticResource HRule}" Margin="0,0,0,14"/>

                                <Button x:Name="T0BtnLoad" Content="📂  Tải ảnh lên"
                                        Height="44" FontSize="14" FontWeight="Bold"
                                        Style="{StaticResource BtnPurpleAction}"
                                        Margin="0,0,0,10"
                                        Click="T0_BtnLoad_Click"/>

                                <Button x:Name="T0BtnRun" Content="🧠  Chạy AI phân tích"
                                        Height="40" FontSize="13" FontWeight="Bold"
                                        Style="{StaticResource BtnPurpleAction}"
                                        IsEnabled="False"
                                        Margin="0,0,0,10"
                                        Click="T0_BtnRun_Click"/>

                                <Border x:Name="T0StatusBadge" Background="#F7F7FB"
                                        BorderBrush="#EBEBF0" BorderThickness="1"
                                        CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                                    <TextBlock x:Name="T0StatusText" Text="Trạng thái: Sẵn sàng"
                                               FontSize="11" FontWeight="Bold" Foreground="#9090A8"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>

                                <ProgressBar x:Name="T0Progress" Height="4" IsIndeterminate="True"
                                             Foreground="#7132F5" Background="#EBEBF0"
                                             Visibility="Collapsed" Margin="0,0,0,10"/>

                                <Button x:Name="T0BtnReset" Content="🔄  Tải lại (Reset)"
                                        Height="40" FontSize="13" FontWeight="Bold"
                                        Style="{StaticResource BtnPurpleAction}"
                                        IsEnabled="False"
                                        Click="T0_BtnReset_Click"/>

                                <StackPanel Margin="0,20,0,0">
                                    <Rectangle Style="{StaticResource HRule}" Margin="0,0,0,10"/>
                                    <Button Content="⚙️  Cài đặt" Height="40" FontSize="13" FontWeight="Bold"
                                            Background="White" Foreground="#9090A8"
                                            BorderBrush="#EBEBF0" BorderThickness="1"
                                            Cursor="Hand" Click="BtnSettings_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.12"/></VisualStateGroup.Transitions>
                                                            <VisualState x:Name="Normal"/>
                                                            <VisualState x:Name="MouseOver">
                                                                <Storyboard>
                                                                    <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#F0F0F8" Duration="0:0:0.12"/>
                                                                </Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Image panes Tab0 -->
                        <Border Grid.Column="2" Background="White"
                                BorderBrush="{StaticResource PrimaryBorderBrush}"
                                BorderThickness="1" CornerRadius="16"
                                Effect="{StaticResource CardShadow}" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FAFAFA"
                                        BorderBrush="#C4B0F7" BorderThickness="1.5"
                                        CornerRadius="12" AllowDrop="True"
                                        Drop="T0_ImagePane_Drop">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="ẢNH GỐC"
                                                   FontSize="10" FontWeight="Bold" Foreground="#9090A8"
                                                   HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                        <Image x:Name="T0ImgOriginal" Grid.Row="1" Stretch="Uniform" Margin="8"/>
                                        <TextBlock x:Name="T0PlaceholderOrig" Grid.Row="1"
                                                   Text="Ảnh gốc&#10;(Chưa tải)&#10;&#10;Kéo thả ảnh vào đây"
                                                   FontSize="13" Foreground="#C0C0D0"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Background="#FAFAFA"
                                        BorderBrush="#C4B0F7" BorderThickness="1.5"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="KẾT QUẢ AI PHÂN TÍCH"
                                                   FontSize="10" FontWeight="Bold" Foreground="#9090A8"
                                                   HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                        <Image x:Name="T0ImgResult" Grid.Row="1" Stretch="Uniform" Margin="8"/>
                                        <TextBlock x:Name="T0PlaceholderResult" Grid.Row="1"
                                                   Text="Kết quả AI&#10;phân tích"
                                                   FontSize="13" Foreground="#C0C0D0"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Result panel Tab0: Phân đoạn NST -->
                        <Border Grid.Column="4" Background="White"
                                BorderBrush="{StaticResource PrimaryBorderBrush}"
                                BorderThickness="1" CornerRadius="16"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="18,14,18,0">
                                    <TextBlock Text="KẾT QUẢ PHÂN ĐOẠN NST"
                                               FontSize="10" FontWeight="Bold" Foreground="#9090A8"
                                               Margin="0,0,0,8"/>
                                    <Rectangle Style="{StaticResource HRule}" Margin="0,0,0,10"/>
                                    <Border x:Name="T0CountDisplay" Background="#FAF8FF"
                                            BorderBrush="#E8E0FF" BorderThickness="1"
                                            CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                        <TextBlock x:Name="T0CountText" Text="Số NST: —"
                                                   FontSize="14" FontWeight="Bold" Foreground="#101114"
                                                   TextWrapping="Wrap" TextAlignment="Center"/>
                                    </Border>
                                    <!-- Denver groups mini grid -->
                                    <Border Background="#F7F7FB" CornerRadius="8"
                                            BorderBrush="#EBEBF0" BorderThickness="1"
                                            Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Phân nhóm Denver" FontSize="10" FontWeight="Bold"
                                                       Foreground="#9090A8" Margin="0,0,0,6"/>
                                            <UniformGrid x:Name="T0DenverGrid" Columns="7" Rows="1"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" Style="{StaticResource KrakenScrollViewer}" Margin="14,0">
                                    <TextBlock x:Name="T0ReportText"
                                               Text="Báo cáo phân đoạn NST sẽ xuất hiện sau khi chạy AI."
                                               FontSize="12" Foreground="#9090A8"
                                               TextWrapping="Wrap" Padding="4"/>
                                </ScrollViewer>
                                <StackPanel Grid.Row="2" Margin="14,10,14,14">
                                    <Button x:Name="T0BtnSave" Content="💾  Lưu ảnh &amp; báo cáo"
                                        Height="38" FontSize="13" FontWeight="Bold"
                                        Style="{StaticResource BtnPurpleAction}"
                                        IsEnabled="False"
                                        Margin="0,0,0,6"
                                        Click="T0_BtnSave_Click"/>
                                    <Button x:Name="T0BtnCSV" Content="📊  Xuất CSV"
                                        Height="38" FontSize="13" FontWeight="Bold"
                                        Style="{StaticResource BtnPurpleAction}"
                                        IsEnabled="False"
                                        Margin="0,0,0,6"
                                        Click="T0_BtnCSV_Click"/>
                                    <Button x:Name="T0BtnAnomaly" Content="⚠️  Xác định bất thường"
                                        Height="38" FontSize="13" FontWeight="Bold"
                                        Style="{StaticResource BtnGreenAction}"
                                        IsEnabled="False"
                                        Click="T0_BtnAnomaly_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ── TAB 1: NST chồng chất ── -->
                    <Grid x:Name="PanelTab1" Margin="20" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="216"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <!-- Control panel Tab1 -->
                        <Border Grid.Column="0" Background="White"
                                BorderBrush="{StaticResource PrimaryBorderBrush}"
                                BorderThickness="1" CornerRadius="16"
                                Effect="{StaticResource CardShadow}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="ĐIỀU KHIỂN" FontSize="10" FontWeight="Bold"
                                           Foreground="#9090A8" Margin="0,0,0,14"/>
                                <Rectangle Style="{StaticResource HRule}" Margin="0,0,0,14"/>

                                <Button x:Name="T1BtnLoad" Content="📂  Tải ảnh lên"
                                        Height="44" FontSize="13" FontWeight="Bold"
                                        Style="{StaticResource BtnRedAction}"
                                        Margin="0,0,0,10"
                                        Click="T1_BtnLoad_Click"/>

                                <Button x:Name="T1BtnRun" Content="🔬  Phân tích chồng lấn"
                                        Height="40" FontSize="13" FontWeight="Bold"
                                        Style="{StaticResource BtnRedAction}"
                                        IsEnabled="False"
                                        Margin="0,0,0,10"
                                        Click="T1_BtnRun_Click"/>

                                <Border x:Name="T1StatusBadge" Background="#F7F7FB"
                                        BorderBrush="#EBEBF0" BorderThickness="1"
                                        CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                                    <TextBlock x:Name="T1StatusText" Text="Trạng thái: Sẵn sàng"
                                               FontSize="11" FontWeight="Bold" Foreground="#9090A8"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>

                                <ProgressBar x:Name="T1Progress" Height="4" IsIndeterminate="True"
                                             Foreground="#DC2626" Background="#EBEBF0"
                                             Visibility="Collapsed" Margin="0,0,0,10"/>

                                <Button x:Name="T1BtnReset" Content="🔄  Tải lại (Reset)"
                                        Height="40" FontSize="13" FontWeight="Bold"
                                        Style="{StaticResource BtnRedAction}"
                                        IsEnabled="False"
                                        Click="T1_BtnReset_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Image panes Tab1 -->
                        <Border Grid.Column="2" Background="White"
                                BorderBrush="#FECACA" BorderThickness="1"
                                CornerRadius="16" Effect="{StaticResource CardShadow}" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FAFAFA"
                                        BorderBrush="#FECACA" BorderThickness="1.5"
                                        CornerRadius="12" AllowDrop="True"
                                        Drop="T1_ImagePane_Drop">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="ẢNH GỐC"
                                                   FontSize="10" FontWeight="Bold" Foreground="#9090A8"
                                                   HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                        <Image x:Name="T1ImgOriginal" Grid.Row="1" Stretch="Uniform" Margin="8"/>
                                        <TextBlock x:Name="T1PlaceholderOrig" Grid.Row="1"
                                                   Text="Ảnh NST chồng chất&#10;(Chưa tải)&#10;&#10;Kéo thả ảnh vào đây"
                                                   FontSize="13" Foreground="#C0C0D0"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Background="#FAFAFA"
                                        BorderBrush="#FECACA" BorderThickness="1.5"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="KẾT QUẢ PHÂN TÁCH"
                                                   FontSize="10" FontWeight="Bold" Foreground="#9090A8"
                                                   HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                        <Image x:Name="T1ImgResult" Grid.Row="1" Stretch="Uniform" Margin="8"/>
                                        <TextBlock x:Name="T1PlaceholderResult" Grid.Row="1"
                                                   Text="Kết quả&#10;phân tách"
                                                   FontSize="13" Foreground="#C0C0D0"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Result panel Tab1: NST chồng chất -->
                        <Border Grid.Column="4" Background="White"
                                BorderBrush="#FECACA" BorderThickness="1"
                                CornerRadius="16" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="18,14,18,0">
                                    <TextBlock Text="KẾT QUẢ NST CHỒNG CHẤT"
                                               FontSize="10" FontWeight="Bold" Foreground="#9090A8"
                                               Margin="0,0,0,8"/>
                                    <Rectangle Style="{StaticResource HRule}" Margin="0,0,0,10"/>
                                    <!-- Overlap count -->
                                    <Border Background="#FFF8F8" BorderBrush="#FECACA"
                                            BorderThickness="1" CornerRadius="10"
                                            Padding="14" Margin="0,0,0,8">
                                        <TextBlock x:Name="T1OverlapCount" Text="NST chồng lấn: —"
                                                   FontSize="14" FontWeight="Bold" Foreground="#DC2626"
                                                   TextWrapping="Wrap" TextAlignment="Center"/>
                                    </Border>
                                    <!-- Stats row -->
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <Border Background="#FFF0F0" CornerRadius="8"
                                                Padding="10,8" Margin="0,0,4,0">
                                            <StackPanel>
                                                <TextBlock x:Name="T1TotalDetected" Text="—"
                                                           FontSize="20" FontWeight="Black"
                                                           Foreground="#DC2626" TextAlignment="Center"/>
                                                <TextBlock Text="Tổng NST" FontSize="10"
                                                           Foreground="#9090A8" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#FFF0F0" CornerRadius="8"
                                                Padding="10,8" Margin="4,0,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="T1OverlapPairs" Text="—"
                                                           FontSize="20" FontWeight="Black"
                                                           Foreground="#B91C1C" TextAlignment="Center"/>
                                                <TextBlock Text="Cặp overlap" FontSize="10"
                                                           Foreground="#9090A8" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" Style="{StaticResource KrakenScrollViewer}" Margin="14,0">
                                    <TextBlock x:Name="T1ReportText"
                                               Text="Báo cáo phân tách NST chồng lấn sẽ xuất hiện sau khi chạy AI."
                                               FontSize="12" Foreground="#9090A8"
                                               TextWrapping="Wrap" Padding="4"/>
                                </ScrollViewer>
                                <StackPanel Grid.Row="2" Margin="14,10,14,14">
                                    <Button x:Name="T1BtnSave" Content="💾  Lưu kết quả"
                                        Height="38" FontSize="13" FontWeight="Bold"
                                        Style="{StaticResource BtnRedAction}"
                                        IsEnabled="False"
                                        Click="T1_BtnSave_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ── TAB 2: Xác định bất thường NST ── -->
                    <Grid x:Name="PanelTab2" Margin="20" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="216"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <!-- Control panel Tab2 -->
                        <Border Grid.Column="0" Background="White"
                                BorderBrush="#BBF7D0" BorderThickness="1"
                                CornerRadius="16" Effect="{StaticResource CardShadow}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="ĐIỀU KHIỂN" FontSize="10" FontWeight="Bold"
                                           Foreground="#9090A8" Margin="0,0,0,14"/>
                                <Rectangle Style="{StaticResource HRule}" Margin="0,0,0,14"/>

                                <Button x:Name="T2BtnRun" Content="⚠️  Phân tích bất thường"
                                        Height="40" FontSize="13" FontWeight="Bold"
                                        Style="{StaticResource BtnGreenAction}"
                                        IsEnabled="False"
                                        Margin="0,0,0,10"
                                        Click="T2_BtnRun_Click"/>

                                <Border x:Name="T2StatusBadge" Background="#F7F7FB"
                                        BorderBrush="#EBEBF0" BorderThickness="1"
                                        CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                                    <TextBlock x:Name="T2StatusText" Text="Trạng thái: Sẵn sàng"
                                               FontSize="11" FontWeight="Bold" Foreground="#9090A8"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>

                                <ProgressBar x:Name="T2Progress" Height="4" IsIndeterminate="True"
                                             Foreground="#16A34A" Background="#EBEBF0"
                                             Visibility="Collapsed" Margin="0,0,0,10"/>

                                <Button x:Name="T2BtnReset" Content="🔄  Tải lại (Reset)"
                                        Height="40" FontSize="13" FontWeight="Bold"
                                        Style="{StaticResource BtnGreenAction}"
                                        IsEnabled="False"
                                        Click="T2_BtnReset_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Image panes Tab2 -->
                        <Border Grid.Column="2" Background="White"
                                BorderBrush="#BBF7D0" BorderThickness="1"
                                CornerRadius="16" Effect="{StaticResource CardShadow}" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FAFAFA"
                                        BorderBrush="#86EFAC" BorderThickness="1.5"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="ẢNH GỐC"
                                                   FontSize="10" FontWeight="Bold" Foreground="#9090A8"
                                                   HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                        <Image x:Name="T2ImgOriginal" Grid.Row="1" Stretch="Uniform" Margin="8"/>
                                        <TextBlock x:Name="T2PlaceholderOrig" Grid.Row="1"
                                                   Text="Ảnh karyotype&#10;(Chưa tải)&#10;&#10;Kéo thả ảnh vào đây"
                                                   FontSize="13" Foreground="#C0C0D0"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Background="#FAFAFA"
                                        BorderBrush="#86EFAC" BorderThickness="1.5"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="KẾT QUẢ PHÂN TÍCH BẤT THƯỜNG"
                                                   FontSize="10" FontWeight="Bold" Foreground="#9090A8"
                                                   HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                        <Image x:Name="T2ImgResult" Grid.Row="1" Stretch="Uniform" Margin="8"/>
                                        <TextBlock x:Name="T2PlaceholderResult" Grid.Row="1"
                                                   Text="Kết quả&#10;bất thường NST"
                                                   FontSize="13" Foreground="#C0C0D0"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Result panel Tab2: Bất thường NST -->
                        <Border Grid.Column="4" Background="White"
                                BorderBrush="#BBF7D0" BorderThickness="1"
                                CornerRadius="16" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="18,14,18,0">
                                    <TextBlock Text="KẾT QUẢ BẤT THƯỜNG NST"
                                               FontSize="10" FontWeight="Bold" Foreground="#9090A8"
                                               Margin="0,0,0,8"/>
                                    <Rectangle Style="{StaticResource HRule}" Margin="0,0,0,10"/>
                                    <!-- Risk level display -->
                                    <Border x:Name="T2RiskDisplay" Background="#F0FDF4"
                                            BorderBrush="#BBF7D0" BorderThickness="1"
                                            CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="MỨC ĐỘ RỦI RO" FontSize="9"
                                                       FontWeight="Bold" Foreground="#9090A8"
                                                       TextAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="T2RiskText" Text="—"
                                                       FontSize="18" FontWeight="Black"
                                                       Foreground="#16A34A" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Syndrome flags -->
                                    <Border Background="#F7F7FB" CornerRadius="8"
                                            BorderBrush="#EBEBF0" BorderThickness="1"
                                            Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Hội chứng nghi ngờ" FontSize="10"
                                                       FontWeight="Bold" Foreground="#9090A8"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock x:Name="T2SyndromeText"
                                                       Text="—" FontSize="11"
                                                       Foreground="#101114" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Sex estimation -->
                                    <Border Background="#F7F7FB" CornerRadius="8"
                                            BorderBrush="#EBEBF0" BorderThickness="1"
                                            Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="Giới tính ước tính" FontSize="10"
                                                       FontWeight="Bold" Foreground="#9090A8"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock x:Name="T2SexText"
                                                       Text="—" FontSize="11"
                                                       Foreground="#101114" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" Style="{StaticResource KrakenScrollViewer}" Margin="14,8,14,0">
                                    <TextBlock x:Name="T2ReportText"
                                               Text="Báo cáo bất thường NST sẽ xuất hiện sau khi chạy AI."
                                               FontSize="12" Foreground="#9090A8"
                                               TextWrapping="Wrap" Padding="4"/>
                                </ScrollViewer>
                                <StackPanel Grid.Row="2" Margin="14,10,14,14">
                                    <Button x:Name="T2BtnSave" Content="💾  Lưu báo cáo lâm sàng"
                                        Height="38" FontSize="13" FontWeight="Bold"
                                        Style="{StaticResource BtnGreenAction}"
                                        IsEnabled="False"
                                        Margin="0,0,0,6"
                                        Click="T2_BtnSave_Click"/>
                                    <Button x:Name="T2BtnCSV" Content="📊  Xuất CSV lâm sàng"
                                        Height="38" FontSize="13" FontWeight="Bold"
                                        Style="{StaticResource BtnGreenAction}"
                                        IsEnabled="False"
                                        Click="T2_BtnCSV_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>

                <!-- ═══════════════════════════════════
                     BOTTOM BAR
                ═══════════════════════════════════ -->
                <Border Grid.Row="3" Background="White"
                        BorderBrush="#EBEBF0" BorderThickness="0,1,0,0">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Chọn tab → Tải ảnh → Chạy AI → Xem kết quả → Lưu"
                                   FontSize="11" Foreground="#B0B0C0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="© MedVision AI — Hỗ trợ nghiên cứu &amp; giáo dục"
                                   FontSize="11" Foreground="#B0B0C0"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
