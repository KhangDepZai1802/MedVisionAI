<Window x:Class="MedVisionAI.UI.Windows.NSTWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MedVision AI — Phân tích Nhiễm sắc thể"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        MinWidth="1200" MinHeight="750"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Border Margin="12" CornerRadius="10"
            Effect="{StaticResource WindowShadow}">
        <Border Background="#F7F7FB" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="62"/>   <!-- TopBar -->
                    <RowDefinition Height="Auto"/>  <!-- Model Toolbar (Yêu cầu [5]) -->
                    <RowDefinition Height="*"/>      <!-- Content -->
                    <RowDefinition Height="30"/>    <!-- BottomBar -->
                </Grid.RowDefinitions>

                <!-- ═══════════════════════════════════
                     TOP BAR
                ═══════════════════════════════════ -->
                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#EBEBF0"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TopBar_MouseDown">

                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Module icon -->
                        <Border Grid.Column="0"
                                Background="#F3EEFF" CornerRadius="12"
                                Width="46" Height="46" Margin="0,0,14,0">
                            <TextBlock Text="🧬" FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- App + module name -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="MedVision AI"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#101114"/>
                            <TextBlock Text="Phân tích Nhiễm sắc thể"
                                       FontSize="11" Foreground="#9090A8"/>
                        </StackPanel>

                        <!-- Back button -->
                        <Button Grid.Column="3"
                                Content="← Trang chủ"
                                Height="34" Padding="16,0"
                                FontSize="12" FontWeight="Bold"
                                Background="White" Foreground="#7132F5"
                                BorderBrush="#7132F5" BorderThickness="1.5"
                                Cursor="Hand"
                                Click="BtnHome_Click"
                                Margin="0,0,16,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualStateGroup.Transitions>
                                                    <VisualTransition GeneratedDuration="0:0:0.15"/>
                                                </VisualStateGroup.Transitions>
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="MouseOver">
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#7132F5" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Clock -->
                        <TextBlock x:Name="ClockLabel"
                                   Grid.Column="4"
                                   Style="{StaticResource LabelClock}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>

                        <!-- Window controls -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource BtnWinCtrl}" Content="─"
                                    Margin="0,0,2,0"
                                    Click="BtnMinimize_Click"/>
                            <Button x:Name="BtnMaxRestore"
                                    Style="{StaticResource BtnWinCtrl}" Content="□"
                                    Margin="0,0,2,0"
                                    Click="BtnMaxRestore_Click"/>
                            <Button Style="{StaticResource BtnDanger}" Content="✕"
                                    Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════
                     MODEL TOOLBAR (Yêu cầu [5])
                ═══════════════════════════════════ -->
                <Border Grid.Row="1"
                        Background="White"
                        BorderBrush="#EBEBF0"
                        BorderThickness="0,0,0,1"
                        Padding="24,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Model 1 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="📂  Model phân đoạn NST"
                                    Height="34" Padding="14,0"
                                    FontSize="12" FontWeight="Bold"
                                    Background="#F3EEFF" Foreground="#7132F5"
                                    BorderBrush="#D4BBFF" BorderThickness="1"
                                    Cursor="Hand"
                                    Click="ToolbarSegmentation_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualStateGroup.Transitions>
                                                        <VisualTransition GeneratedDuration="0:0:0.12"/>
                                                    </VisualStateGroup.Transitions>
                                                    <VisualState x:Name="Normal"/>
                                                    <VisualState x:Name="MouseOver">
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#E8DDFF" Duration="0:0:0.12"/>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock x:Name="ToolbarSeg"
                                       Text="Chưa chọn"
                                       FontSize="11" Foreground="#9090A8"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       MaxWidth="160"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Rectangle Grid.Column="1" Width="1" Height="24"
                                   Fill="#EBEBF0" HorizontalAlignment="Center"/>

                        <!-- Model 2 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="📂  Model NST chồng lấn"
                                    Height="34" Padding="14,0"
                                    FontSize="12" FontWeight="Bold"
                                    Background="#F7F7FB" Foreground="#9090A8"
                                    BorderBrush="#EBEBF0" BorderThickness="1"
                                    Cursor="Hand"
                                    Click="ToolbarOverlap_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualStateGroup.Transitions>
                                                        <VisualTransition GeneratedDuration="0:0:0.12"/>
                                                    </VisualStateGroup.Transitions>
                                                    <VisualState x:Name="Normal"/>
                                                    <VisualState x:Name="MouseOver">
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#EBEBF0" Duration="0:0:0.12"/>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock x:Name="ToolbarOverlap"
                                       Text="Chưa chọn"
                                       FontSize="11" Foreground="#9090A8"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       MaxWidth="160"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Rectangle Grid.Column="3" Width="1" Height="24"
                                   Fill="#EBEBF0" HorizontalAlignment="Center"/>

                        <!-- Model 3 -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <Button Content="📂  Model xác định bất thường"
                                    Height="34" Padding="14,0"
                                    FontSize="12" FontWeight="Bold"
                                    Background="#F7F7FB" Foreground="#9090A8"
                                    BorderBrush="#EBEBF0" BorderThickness="1"
                                    Cursor="Hand"
                                    Click="ToolbarAnomaly_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualStateGroup.Transitions>
                                                        <VisualTransition GeneratedDuration="0:0:0.12"/>
                                                    </VisualStateGroup.Transitions>
                                                    <VisualState x:Name="Normal"/>
                                                    <VisualState x:Name="MouseOver">
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#EBEBF0" Duration="0:0:0.12"/>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock x:Name="ToolbarAnomaly"
                                       Text="Chưa chọn"
                                       FontSize="11" Foreground="#9090A8"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       MaxWidth="160"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════
                     MAIN CONTENT
                ═══════════════════════════════════ -->
                <Grid Grid.Row="2" Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="216"/>  <!-- Control panel -->
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>    <!-- Image panes -->
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="300"/>  <!-- Result panel -->
                    </Grid.ColumnDefinitions>

                    <!-- CONTROL PANEL -->
                    <Border Grid.Column="0"
                            Background="White"
                            BorderBrush="{StaticResource PrimaryBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Effect="{StaticResource CardShadow}"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="ĐIỀU KHIỂN"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#9090A8"
                                       Margin="0,0,0,14"/>
                            <Rectangle Style="{StaticResource HRule}" Margin="0,0,0,14"/>

                            <!-- Load image -->
                            <Button Content="📂  Tải ảnh lên"
                                    Height="44" FontSize="14" FontWeight="Bold"
                                    Background="White" Foreground="#7132F5"
                                    BorderBrush="#7132F5" BorderThickness="1.5"
                                    Cursor="Hand" Margin="0,0,0,10"
                                    Click="BtnLoadImage_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10"
                                                Padding="20,0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualStateGroup.Transitions>
                                                        <VisualTransition GeneratedDuration="0:0:0.15"/>
                                                    </VisualStateGroup.Transitions>
                                                    <VisualState x:Name="Normal"/>
                                                    <VisualState x:Name="MouseOver">
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#7132F5" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Run AI -->
                            <Button x:Name="BtnRunAI"
                                    Content="🧠  Chạy AI phân tích"
                                    Height="40" FontSize="13" FontWeight="Bold"
                                    Background="White" Foreground="#7132F5"
                                    BorderBrush="#7132F5" BorderThickness="1.5"
                                    IsEnabled="False" Cursor="Hand"
                                    Margin="0,0,0,10"
                                    Click="BtnRunAI_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10" Opacity="{TemplateBinding Opacity}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualStateGroup.Transitions>
                                                        <VisualTransition GeneratedDuration="0:0:0.15"/>
                                                    </VisualStateGroup.Transitions>
                                                    <VisualState x:Name="Normal"/>
                                                    <VisualState x:Name="MouseOver">
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#7132F5" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Disabled">
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#F3F0FB" Duration="0"/>
                                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#D4BBFF" Duration="0"/>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="#B0A0D8"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Status badge -->
                            <Border x:Name="StatusBadge"
                                    Background="#F7F7FB"
                                    BorderBrush="#EBEBF0" BorderThickness="1"
                                    CornerRadius="8" Padding="10,6"
                                    Margin="0,0,0,10">
                                <TextBlock x:Name="StatusText"
                                           Text="Trạng thái: Sẵn sàng"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#9090A8"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </Border>

                            <!-- Progress bar -->
                            <ProgressBar x:Name="ProgressBar"
                                         Height="4" IsIndeterminate="True"
                                         Foreground="#7132F5"
                                         Background="#EBEBF0"
                                         Visibility="Collapsed"
                                         Margin="0,0,0,10"/>

                            <!-- Reset -->
                            <Button x:Name="BtnReset"
                                    Content="🔄  Tải lại (Reset)"
                                    Height="40" FontSize="13" FontWeight="Bold"
                                    Background="White" Foreground="#7132F5"
                                    BorderBrush="#7132F5" BorderThickness="1.5"
                                    IsEnabled="False" Cursor="Hand"
                                    Click="BtnReset_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <StackPanel VerticalAlignment="Bottom" Margin="0,20,0,0">
                                <Rectangle Style="{StaticResource HRule}" Margin="0,0,0,10"/>
                                <!-- Settings button -->
                                <Button Content="⚙️  Cài đặt"
                                        Height="40" FontSize="13" FontWeight="Bold"
                                        Background="White" Foreground="#9090A8"
                                        BorderBrush="#EBEBF0" BorderThickness="1"
                                        Cursor="Hand"
                                        Click="BtnSettings_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualStateGroup.Transitions>
                                                            <VisualTransition GeneratedDuration="0:0:0.12"/>
                                                        </VisualStateGroup.Transitions>
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="MouseOver">
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#F0F0F8" Duration="0:0:0.12"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- IMAGE PANES -->
                    <Border Grid.Column="2"
                            Background="White"
                            BorderBrush="{StaticResource PrimaryBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Effect="{StaticResource CardShadow}"
                            Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Original image pane -->
                            <Border Grid.Column="0"
                                    Background="#FAFAFA"
                                    BorderBrush="#C4B0F7"
                                    BorderThickness="1.5"
                                    CornerRadius="12"
                                    AllowDrop="True"
                                    Drop="ImagePane_Drop">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Text="ẢNH GỐC"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="#9090A8"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,4"/>
                                    <Image x:Name="ImgOriginal"
                                           Grid.Row="1"
                                           Stretch="Uniform"
                                           Margin="8"/>
                                    <TextBlock x:Name="PlaceholderOriginal"
                                               Grid.Row="1"
                                               Text="Ảnh gốc&#10;(Chưa tải)&#10;&#10;Kéo thả ảnh vào đây"
                                               FontSize="13" Foreground="#C0C0D0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Result image pane -->
                            <Border Grid.Column="2"
                                    Background="#FAFAFA"
                                    BorderBrush="#C4B0F7"
                                    BorderThickness="1.5"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Text="KẾT QUẢ AI PHÂN TÍCH"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="#9090A8"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,4"/>
                                    <Image x:Name="ImgResult"
                                           Grid.Row="1"
                                           Stretch="Uniform"
                                           Margin="8"/>
                                    <TextBlock x:Name="PlaceholderResult"
                                               Grid.Row="1"
                                               Text="Kết quả AI&#10;phân tích"
                                               FontSize="13" Foreground="#C0C0D0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- RESULT PANEL -->
                    <Border Grid.Column="4"
                            Background="White"
                            BorderBrush="{StaticResource PrimaryBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Grid.Row="0" Margin="20,16,20,0">
                                <TextBlock Text="KẾT QUẢ PHÂN TÍCH"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#9090A8"
                                           Margin="0,0,0,8"/>
                                <Rectangle Style="{StaticResource HRule}" Margin="0,0,0,12"/>

                                <!-- Count display -->
                                <Border x:Name="CountDisplay"
                                        Background="#FAF8FF"
                                        BorderBrush="#E8E0FF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,0,0,12">
                                    <TextBlock x:Name="CountText"
                                               Text="Kết quả đếm: —"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="#101114"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Report scroll area -->
                            <ScrollViewer Grid.Row="1"
                                          Style="{StaticResource KrakenScrollViewer}"
                                          Margin="16,0">
                                <TextBlock x:Name="ReportText"
                                           Text="Báo cáo chi tiết sẽ xuất hiện sau khi chạy AI."
                                           FontSize="13" Foreground="#9090A8"
                                           TextWrapping="Wrap"
                                           Padding="4"/>
                            </ScrollViewer>

                            <!-- Action buttons -->
                            <StackPanel Grid.Row="2" Margin="16,12,16,16">
                                <Button x:Name="BtnSave"
                                        Content="💾  Lưu ảnh &amp; báo cáo"
                                        Height="40" FontSize="13" FontWeight="Bold"
                                        IsEnabled="False" Cursor="Hand"
                                        Background="White" Foreground="#7132F5"
                                        BorderBrush="#7132F5" BorderThickness="1.5"
                                        Click="BtnSave_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualStateGroup.Transitions>
                                                            <VisualTransition GeneratedDuration="0:0:0.15"/>
                                                        </VisualStateGroup.Transitions>
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="MouseOver">
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#7132F5" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Disabled">
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#F3F0FB" Duration="0"/>
                                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                    To="#D4BBFF" Duration="0"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="#B0A0D8"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button x:Name="BtnExportCSV"
                                        Content="📊  Xuất báo cáo CSV"
                                        Height="40" FontSize="13" FontWeight="Bold"
                                        IsEnabled="False" Cursor="Hand"
                                        Background="White" Foreground="#7132F5"
                                        BorderBrush="#7132F5" BorderThickness="1.5"
                                        Click="BtnExportCSV_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualStateGroup.Transitions>
                                                            <VisualTransition GeneratedDuration="0:0:0.15"/>
                                                        </VisualStateGroup.Transitions>
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="MouseOver">
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#7132F5" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Disabled">
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#F3F0FB" Duration="0"/>
                                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                    To="#D4BBFF" Duration="0"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="#B0A0D8"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════
                     BOTTOM BAR
                ═══════════════════════════════════ -->
                <Border Grid.Row="3"
                        Background="White"
                        BorderBrush="#EBEBF0"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Upload → Phân tích → Xem kết quả → Lưu / Xuất"
                                   FontSize="11" Foreground="#B0B0C0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="© MedVision AI — Hỗ trợ nghiên cứu &amp; giáo dục"
                                   FontSize="11" Foreground="#B0B0C0"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Border>
</Window>
