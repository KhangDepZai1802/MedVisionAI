<Window x:Class="MedVisionAI.UI.Windows.ModelSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn Model AI — Phân tích NST"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="580" Height="Auto"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border Margin="12" CornerRadius="16"
            Effect="{StaticResource WindowShadow}"
            Background="White">

        <StackPanel Margin="36,32,36,32">

            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Background="#F3EEFF" CornerRadius="10"
                            Padding="10,6" HorizontalAlignment="Left"
                            Margin="0,0,0,10">
                        <TextBlock Text="🧬  Phân tích Nhiễm sắc thể"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#7132F5"/>
                    </Border>
                    <TextBlock Text="Chọn model AI cho từng chức năng"
                               FontSize="20" FontWeight="Black"
                               Foreground="#101114"/>
                    <TextBlock Text="Bạn có thể bỏ qua model chưa có — app vẫn hoạt động với chức năng có sẵn"
                               FontSize="12" Foreground="#9090A8"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource BtnDanger}"
                        Content="✕"
                        Click="BtnCancel_Click"
                        VerticalAlignment="Top"/>
            </Grid>

            <!-- Divider -->
            <Rectangle Style="{StaticResource HRule}" Margin="0,0,0,24"/>

            <!-- Model 1: Phân đoạn -->
            <Border Background="#FAFAFA" CornerRadius="12"
                    BorderBrush="#EBEBF0" BorderThickness="1"
                    Padding="20,16" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Background="#F3EEFF" CornerRadius="8"
                                Width="32" Height="32" Margin="0,0,12,0">
                            <TextBlock Text="①" FontSize="14" FontWeight="Bold"
                                       Foreground="#7132F5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Model Phân đoạn NST"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#101114"/>
                            <TextBlock Text="Tách từng nhiễm sắc thể ra khỏi ảnh · Đếm tổng số NST"
                                       FontSize="11" Foreground="#9090A8"/>
                        </StackPanel>
                        <Border Background="#F0FDF4" CornerRadius="6"
                                Padding="8,3" Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="Bắt buộc" FontSize="10" FontWeight="Bold"
                                       Foreground="#15803D"/>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="White" CornerRadius="8"
                                BorderBrush="#D4BBFF" BorderThickness="1"
                                Padding="12,10">
                            <TextBlock x:Name="PathSegmentation"
                                       Text="Chưa chọn file model (.onnx, .pt, .pth, .h5)"
                                       FontSize="12" Foreground="#9090A8"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Button Grid.Column="2"
                                Content="📂  Browse"
                                Click="BrowseSegmentation_Click"
                                Height="40" Padding="16,0"
                                FontSize="13" FontWeight="Bold"
                                Background="#7132F5" Foreground="White"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualStateGroup.Transitions>
                                                    <VisualTransition GeneratedDuration="0:0:0.12"/>
                                                </VisualStateGroup.Transitions>
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="MouseOver">
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#5E22D4" Duration="0:0:0.12"/>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#4A1AB0" Duration="0:0:0.05"/>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Model 2: Phân tách chồng lấn -->
            <Border Background="#FAFAFA" CornerRadius="12"
                    BorderBrush="#EBEBF0" BorderThickness="1"
                    Padding="20,16" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Background="#FFF0F0" CornerRadius="8"
                                Width="32" Height="32" Margin="0,0,12,0">
                            <TextBlock Text="②" FontSize="14" FontWeight="Bold"
                                       Foreground="#DC2626"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Model Phân tách NST chồng lấn"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#101114"/>
                            <TextBlock Text="Xử lý các nhiễm sắc thể bị đè lên nhau"
                                       FontSize="11" Foreground="#9090A8"/>
                        </StackPanel>
                        <Border Background="#F7F7FB" CornerRadius="6"
                                Padding="8,3" Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="Tuỳ chọn" FontSize="10" FontWeight="Bold"
                                       Foreground="#9090A8"/>
                        </Border>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="White" CornerRadius="8"
                                BorderBrush="#EBEBF0" BorderThickness="1"
                                Padding="12,10">
                            <TextBlock x:Name="PathOverlap"
                                       Text="Chưa chọn (bỏ qua nếu không có)"
                                       FontSize="12" Foreground="#9090A8"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Button Grid.Column="2"
                                Content="📂  Browse"
                                Click="BrowseOverlap_Click"
                                Height="40" Padding="16,0"
                                FontSize="13" FontWeight="Bold"
                                Background="#9090A8" Foreground="White"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualStateGroup.Transitions>
                                                    <VisualTransition GeneratedDuration="0:0:0.12"/>
                                                </VisualStateGroup.Transitions>
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="MouseOver">
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#7A7A90" Duration="0:0:0.12"/>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Model 3: Xác định bất thường -->
            <Border Background="#FAFAFA" CornerRadius="12"
                    BorderBrush="#EBEBF0" BorderThickness="1"
                    Padding="20,16" Margin="0,0,0,28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Background="#F0FDF4" CornerRadius="8"
                                Width="32" Height="32" Margin="0,0,12,0">
                            <TextBlock Text="③" FontSize="14" FontWeight="Bold"
                                       Foreground="#16A34A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Model Xác định bất thường số lượng NST"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#101114"/>
                            <TextBlock Text="Phát hiện lệch bội, hội chứng di truyền"
                                       FontSize="11" Foreground="#9090A8"/>
                        </StackPanel>
                        <Border Background="#F7F7FB" CornerRadius="6"
                                Padding="8,3" Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="Tuỳ chọn" FontSize="10" FontWeight="Bold"
                                       Foreground="#9090A8"/>
                        </Border>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="White" CornerRadius="8"
                                BorderBrush="#EBEBF0" BorderThickness="1"
                                Padding="12,10">
                            <TextBlock x:Name="PathAnomaly"
                                       Text="Chưa chọn (bỏ qua nếu không có)"
                                       FontSize="12" Foreground="#9090A8"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Button Grid.Column="2"
                                Content="📂  Browse"
                                Click="BrowseAnomaly_Click"
                                Height="40" Padding="16,0"
                                FontSize="13" FontWeight="Bold"
                                Background="#9090A8" Foreground="White"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualStateGroup.Transitions>
                                                    <VisualTransition GeneratedDuration="0:0:0.12"/>
                                                </VisualStateGroup.Transitions>
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="MouseOver">
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#7A7A90" Duration="0:0:0.12"/>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Action buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Bỏ qua — vào xem giao diện"
                        Height="44" FontSize="13"
                        Background="#F0F0F8" Foreground="#5A5A72"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnSkip_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="10" Padding="20,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.12"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#E8E8F0" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="2"
                        Content="🚀  Bắt đầu phân tích"
                        Height="44" Padding="28,0"
                        FontSize="14" FontWeight="Bold"
                        Background="#7132F5" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnStart_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.12"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#5E22D4" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#4A1AB0" Duration="0:0:0.05"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

        </StackPanel>
    </Border>
</Window>
