<Window x:Class="MedVisionAI.UI.Windows.MedicalClassifierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MedVision AI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/Assets/Brand/AppIcon.ico"
        ResizeMode="CanResize"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <ControlTemplate x:Key="ModuleButtonTemplate" TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="ModuleActionButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template" Value="{StaticResource ModuleButtonTemplate}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="10" Effect="{StaticResource WindowShadow}">
        <Border Background="#F7F7FB" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="62"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#EBEBF0"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TopBar_MouseDown">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="Transparent"
                                Width="46" Height="46" Margin="0,0,14,0">
                            <Image x:Name="HeaderLogo"
                                   Width="38" Height="38"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderTitle"
                                       Text="Phân tích hình ảnh"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#101114"/>
                            <TextBlock x:Name="HeaderSubtitle"
                                       Text="AI classifier"
                                       FontSize="11" Foreground="#9090A8"/>
                        </StackPanel>

                        <Border Grid.Column="3"
                                Background="#FAFAFA"
                                BorderBrush="#E5E0F5"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,7"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Model: "
                                           FontSize="11"
                                           Foreground="#9090A8"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="ModelBadgeText"
                                           Text="Chưa chọn"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#7132F5"
                                           MaxWidth="210"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="BtnChangeModel"
                                        Content="Đổi"
                                        Height="22"
                                        Padding="9,0"
                                        Margin="8,0,0,0"
                                        FontSize="10"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="BtnChangeModel_Click"
                                        Template="{StaticResource ModuleButtonTemplate}"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnHome"
                                Grid.Column="4"
                                Content="← Trang chủ"
                                Height="34"
                                Padding="16,0"
                                FontSize="12"
                                Style="{StaticResource ModuleActionButton}"
                                Click="BtnHome_Click"
                                Margin="0,0,16,0"/>

                        <TextBlock x:Name="ClockLabel"
                                   Grid.Column="5"
                                   Style="{StaticResource LabelClock}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>

                        <StackPanel Grid.Column="6"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource BtnWinCtrl}" Content="─"
                                    Margin="0,0,2,0" Click="BtnMinimize_Click"/>
                            <Button x:Name="BtnMaxRestore"
                                    Style="{StaticResource BtnWinCtrl}" Content="□"
                                    Margin="0,0,2,0" Click="BtnMaxRestore_Click"/>
                            <Button Style="{StaticResource BtnDanger}" Content="✕"
                                    Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="216"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="310"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ControlPanel"
                            Grid.Column="0"
                            Background="White"
                            BorderThickness="1"
                            CornerRadius="16"
                            Effect="{StaticResource CardShadow}"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="ĐIỀU KHIỂN"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#9090A8"
                                       Margin="0,0,0,14"/>
                            <Rectangle Style="{StaticResource HRule}" Margin="0,0,0,14"/>

                            <Button x:Name="BtnModel"
                                    Content="Chọn model AI"
                                    Height="42"
                                    FontSize="13"
                                    Style="{StaticResource ModuleActionButton}"
                                    Margin="0,0,0,10"
                                    Click="BtnModel_Click"/>

                            <Button x:Name="BtnLoad"
                                    Content="Tải ảnh lên"
                                    Height="44"
                                    FontSize="14"
                                    Style="{StaticResource ModuleActionButton}"
                                    Margin="0,0,0,10"
                                    Click="BtnLoad_Click"/>

                            <Button x:Name="BtnRun"
                                    Content="Chạy AI phân tích"
                                    Height="40"
                                    FontSize="13"
                                    Style="{StaticResource ModuleActionButton}"
                                    IsEnabled="False"
                                    Margin="0,0,0,10"
                                    Click="BtnRun_Click"/>

                            <Border x:Name="StatusBadge"
                                    Background="#F7F7FB"
                                    BorderBrush="#EBEBF0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,6"
                                    Margin="0,0,0,10">
                                <TextBlock x:Name="StatusText"
                                           Text="Trạng thái: Sẵn sàng"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#9090A8"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </Border>

                            <ProgressBar x:Name="Progress"
                                         Height="4"
                                         IsIndeterminate="True"
                                         Background="#EBEBF0"
                                         Visibility="Collapsed"
                                         Margin="0,0,0,10"/>

                            <Button x:Name="BtnReset"
                                    Content="Tải lại (Reset)"
                                    Height="40"
                                    FontSize="13"
                                    Style="{StaticResource ModuleActionButton}"
                                    IsEnabled="False"
                                    Click="BtnReset_Click"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ImagePanel"
                            Grid.Column="2"
                            Background="White"
                            BorderThickness="1"
                            CornerRadius="16"
                            Effect="{StaticResource CardShadow}"
                            Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="OriginalPane"
                                    Grid.Column="0"
                                    Background="#FAFAFA"
                                    BorderThickness="1.5"
                                    CornerRadius="12"
                                    AllowDrop="True"
                                    Drop="ImagePane_Drop">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Text="ẢNH GỐC"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#9090A8"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,4"/>
                                    <Image x:Name="ImgOriginal"
                                           Grid.Row="1"
                                           Stretch="Uniform"
                                           Margin="8"/>
                                    <TextBlock x:Name="PlaceholderOrig"
                                               Grid.Row="1"
                                               Text="Ảnh gốc&#10;(Chưa tải)&#10;&#10;Kéo thả ảnh vào đây"
                                               FontSize="13"
                                               Foreground="#C0C0D0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border x:Name="ResultPane"
                                    Grid.Column="2"
                                    Background="#FAFAFA"
                                    BorderThickness="1.5"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Text="KẾT QUẢ AI PHÂN TÍCH"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#9090A8"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,4"/>
                                    <Image x:Name="ImgResult"
                                           Grid.Row="1"
                                           Stretch="Uniform"
                                           Margin="8"/>
                                    <TextBlock x:Name="PlaceholderResult"
                                               Grid.Row="1"
                                               Text="AI focus&#10;kết quả phân tích"
                                               FontSize="13"
                                               Foreground="#C0C0D0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="ResultPanel"
                            Grid.Column="4"
                            Background="White"
                            BorderThickness="1"
                            CornerRadius="16"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="18,14,18,0">
                                <TextBlock x:Name="ResultPanelTitle"
                                           Text="KẾT QUẢ PHÂN TÍCH"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#9090A8"
                                           Margin="0,0,0,8"/>
                                <Rectangle Style="{StaticResource HRule}" Margin="0,0,0,10"/>

                                <Border x:Name="ResultDisplay"
                                        Background="#FAFAFA"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="KẾT QUẢ AI"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#9090A8"
                                                   TextAlignment="Center"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="ResultText"
                                                   Text="—"
                                                   FontSize="17"
                                                   FontWeight="Black"
                                                   Foreground="#101114"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <Border Background="#F7F7FB"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="ĐỘ TIN CẬY"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="#9090A8"
                                                       TextAlignment="Center"/>
                                            <TextBlock x:Name="ConfidenceText"
                                                       Text="—"
                                                       FontSize="18"
                                                       FontWeight="Black"
                                                       TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F7F7FB"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ĐÁNH GIÁ"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="#9090A8"
                                                       TextAlignment="Center"/>
                                            <TextBlock x:Name="RiskText"
                                                       Text="—"
                                                       FontSize="13"
                                                       FontWeight="Black"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1"
                                          Style="{StaticResource KrakenScrollViewer}"
                                          Margin="14,6,14,0">
                                <TextBlock x:Name="ReportText"
                                           Text="Báo cáo phân tích sẽ xuất hiện sau khi chạy AI."
                                           FontSize="12"
                                           Foreground="#9090A8"
                                           TextWrapping="Wrap"
                                           Padding="4"/>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Margin="14,10,14,14">
                                <Button x:Name="BtnSave"
                                        Content="Lưu ảnh &amp; báo cáo"
                                        Height="38"
                                        FontSize="13"
                                        Style="{StaticResource ModuleActionButton}"
                                        IsEnabled="False"
                                        Click="BtnSave_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Background="White"
                        BorderBrush="#EBEBF0"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="24,0">
                        <TextBlock Text="Chọn model AI → Tải ảnh → Chạy AI → Xem vùng AI focus → Lưu kết quả"
                                   FontSize="11"
                                   Foreground="#B0B0C0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="© MedVision AI — Hỗ trợ nghiên cứu &amp; giáo dục"
                                   FontSize="11"
                                   Foreground="#B0B0C0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
