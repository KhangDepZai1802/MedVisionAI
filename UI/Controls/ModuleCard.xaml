<UserControl x:Class="MedVisionAI.UI.Controls.ModuleCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand" Height="186">

    <UserControl.Resources>
        <Storyboard x:Key="HoverIn">
            <ColorAnimation Storyboard.TargetName="CardBorder"
                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                To="#7132F5" Duration="0:0:0.18"/>
            <ColorAnimation Storyboard.TargetName="CardBorder"
                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                To="#FAF8FF" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleX"
                To="1.012" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleY"
                To="1.012" Duration="0:0:0.18"/>
            <ThicknessAnimation Storyboard.TargetName="CardBorder"
                Storyboard.TargetProperty="BorderThickness"
                To="2" Duration="0:0:0.18"/>
        </Storyboard>
        <Storyboard x:Key="HoverOut">
            <ColorAnimation Storyboard.TargetName="CardBorder"
                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                To="#EBEBF0" Duration="0:0:0.18"/>
            <ColorAnimation Storyboard.TargetName="CardBorder"
                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                To="#FFFFFF" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleX"
                To="1" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleY"
                To="1" Duration="0:0:0.18"/>
            <ThicknessAnimation Storyboard.TargetName="CardBorder"
                Storyboard.TargetProperty="BorderThickness"
                To="1" Duration="0:0:0.18"/>
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard Storyboard="{StaticResource HoverIn}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard Storyboard="{StaticResource HoverOut}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Border x:Name="CardBorder"
            Background="White"
            BorderBrush="#EBEBF0"
            BorderThickness="1"
            CornerRadius="16"
            Effect="{StaticResource CardShadow}"
            Padding="22,20">
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>

        <StackPanel>
            <!-- Icon bubble -->
            <Border x:Name="IconBubble"
                    Width="46" Height="46"
                    CornerRadius="12"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,10">
                <TextBlock x:Name="IconText"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Title -->
            <TextBlock x:Name="TitleText"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="#101114"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>

            <!-- Description -->
            <TextBlock x:Name="DescText"
                       FontSize="12"
                       Foreground="#7A7A9A"
                       TextWrapping="Wrap"
                       LineHeight="19"
                       Margin="0,0,0,10"/>

            <!-- Badge -->
            <Border x:Name="BadgeBorder"
                    HorizontalAlignment="Left"
                    CornerRadius="20"
                    Padding="12,3">
                <TextBlock x:Name="BadgeText"
                           FontSize="11"
                           FontWeight="Bold"/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
